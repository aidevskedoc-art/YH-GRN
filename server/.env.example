# Copy this file to .env, beside it in server/, and fill in your own values.
#   cp server/.env.example server/.env

# --- Server ---
PORT=4100
NODE_ENV=development

# --- PostgreSQL ---
# Create the database first:  CREATE DATABASE yh_grn;
DATABASE_URL=postgresql://postgres:password@localhost:5432/yh_grn

# --- Auth ---
# Use a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# --- Seed admin account (created by `npm run migrate`) ---
SEED_ADMIN_USERNAME=Admin
SEED_ADMIN_PASSWORD=Admin@123
SEED_ADMIN_NAME=Administrator

# --- Uploads ---
MAX_UPLOAD_MB=25

# --- CORS: where the React dev server runs ---
CLIENT_ORIGIN=http://localhost:5173
